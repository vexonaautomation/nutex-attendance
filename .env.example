# NUTEX environment. Copy to .env (npm run setup does this and generates the session secret below).
# Never commit .env or any key file. Values here are placeholders, not credentials.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
# google  = real Google Sheets + Drive (production)
# emulator = offline development only: a local spreadsheet engine evaluates the same formulas. Refused when NODE_ENV=production.
NUTEX_BACKEND=emulator
PORT=4000
HOST=0.0.0.0
# origin(s) of the web app, comma separated (https:// in production)
CORS_ORIGIN=http://localhost:3000
COMPANY_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------- security
# >= 32 chars. Signs session tokens. Generated by npm run setup.
SESSION_SECRET=replace-with-48-random-characters-generated-by-npm-run-setup
SESSION_TTL_MIN=480
# true in production (HTTPS is also required: browsers only share location on https)
COOKIE_SECURE=false
# failed sign-ins before an account locks, and sign-ins per minute per IP. 0 turns a protection OFF, which is refused when NODE_ENV=production.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_MIN=20
# emulator backend only: 0 = do NOT create the local test login admin/admin and keep lockout / rate limit ON
# NUTEX_DEV_ADMIN=0

# ---------------------------------------------------------------- Google (NUTEX_BACKEND=google)
# Provide ONE of the two credential options. The service-account key never goes to the browser.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# or the JSON itself (raw or base64) from a secret manager:
GOOGLE_SERVICE_ACCOUNT_JSON=
# printed by: npm run google:create
GOOGLE_SPREADSHEET_ID=
DRIVE_ROOT_FOLDER_ID=
DRIVE_DOCS_FOLDER_ID=
DRIVE_PAYSLIP_FOLDER_ID=
# Google Sheets allows 60 reads/min per user per project (300 per project). Reads are cached in-process; raise this for busy sites.
# Writes invalidate the cache of the instance that wrote; other instances see changes within this many milliseconds.
READ_CACHE_TTL_MS=30000
# optional: put the workbook and folders inside this Drive folder / Shared Drive (share it with the service account as Editor)
DRIVE_PARENT_FOLDER_ID=
# folder for `npm run backup` copies (defaults to the root folder)
DRIVE_BACKUP_FOLDER_ID=
# 0 < scale <= 1. 1 = ~6.9M cells (production capacity). 0.25 = ~1.8M cells, fine for ~150 employees. Must be identical for
# google:create, the API and the verify scripts.
CAPACITY_SCALE=0.25
# humans who may edit protected ranges / open the workbook (comma separated Google account emails)
GOOGLE_ADMIN_EMAILS=
# optional Apps Script web-app gateway (see google/apps-script)
APPS_SCRIPT_GATEWAY_URL=

# ---------------------------------------------------------------- demo / ops
# password for all seeded DEMO users; random per user (written to .local/seed-credentials.txt) when empty
SEED_PASSWORD=
BACKUP_RETENTION_DAYS=90

# ---------------------------------------------------------------- web (apps/web)
# where the Next.js server proxies /api/* to
API_URL=http://127.0.0.1:4000
