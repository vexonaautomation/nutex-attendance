{
  "name": "nutex-attendance-payroll",
  "private": true,
  "version": "2.0.0",
  "description": "NUTEX Attendance, Leave and Payroll platform with location-verified check-in / check-out. Google Sheets is the database and calculation engine.",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "tsx scripts/setup-project.ts",
    "verify:env": "tsx scripts/verify-env.ts",
    "schema:generate": "tsx scripts/generate-schema.ts",
    "apps-script:generate": "tsx scripts/generate-apps-script.ts",
    "verify:headers": "tsx scripts/verify-sheet-headers.ts",
    "verify:formulas": "tsx scripts/verify-formulas.ts",
    "google:create": "tsx google/setup/create-workbook.ts",
    "google:init": "tsx google/setup/init-production.ts",
    "google:protect": "tsx google/setup/protect-workbook.ts",
    "google:roles": "tsx google/setup/sync-roles.ts",
    "google:reset-password": "tsx google/setup/reset-password.ts",
    "google:seed": "tsx google/setup/seed-nutex.ts",
    "google:triggers": "tsx google/setup/install-triggers.ts",
    "google:verify": "tsx google/setup/verify-google-setup.ts",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "backup": "tsx scripts/backup-google-data.ts",
    "start:api": "npm run start -w @nutex/api",
    "start:web": "npm run start -w @nutex/web",
    "dev:api": "npm run dev -w @nutex/api",
    "dev:web": "npm run dev -w @nutex/web",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run build -w @nutex/web",
    "check": "npm run schema:generate && npm run apps-script:generate && npm run docs:generate && npm run verify:headers && npm run typecheck && npm run lint && npm run test && npm run verify:formulas && npm run build",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "dev:mobile": "tsx scripts/dev-mobile.ts",
    "dev:live": "tsx scripts/dev-mobile.ts --live"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@next/eslint-plugin-next": "^16.3.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hyperformula": "^3.4.0",
    "selfsigned": "^5.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.5",
    "googleapis": "^182.0.0",
    "jose": "^6.2.12",
    "next": "^16.3.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
