var NUTEX_BUDGET_MS = 4.5 * 60 * 1000;
var NUTEX_STATE_KEY = 'nutex_build';

function onOpen() {
  SpreadsheetApp.getUi().createMenu('NUTEX')
    .addItem('Build workbook (all tabs, headers, formulas)', 'nutexBuild')
    .addItem('Check workbook', 'nutexCheck')
    .addItem('Add protections only', 'nutexProtectOnly')
    .addItem('Reset build progress (if it got stuck)', 'nutexReset')
    .addToUi();
}

function nutexToast_(msg) {
  SpreadsheetApp.getActiveSpreadsheet().toast(msg, 'NUTEX', 20);
}

function nutexAlert_(title, msg) {
  try { SpreadsheetApp.getUi().alert(title, msg, SpreadsheetApp.getUi().ButtonSet.OK); } catch (e) { nutexToast_(title + ': ' + msg); }
}

/** the build is resumable: Google stops a script after about 6 minutes, so it works in chunks and continues by itself */
function nutexBuild() {
  var started = Date.now();
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var props = PropertiesService.getDocumentProperties();
  var state = JSON.parse(props.getProperty(NUTEX_STATE_KEY) || 'null');
  if (!state) {
    var clash = NUTEX_TABS.filter(function (t) { return ss.getSheetByName(t.name); }).map(function (t) { return t.name; });
    if (clash.length) throw new Error('This spreadsheet already has NUTEX tabs (' + clash.slice(0, 3).join(', ') + '). Use a new blank spreadsheet.');
    ss.rename(NUTEX_SETTINGS.WORKBOOK_NAME);
    ss.setSpreadsheetLocale(NUTEX_SETTINGS.LOCALE);
    ss.setSpreadsheetTimeZone(NUTEX_SETTINGS.TIMEZONE);
    state = { phase: 'sheets', next: 0 };
    nutexToast_('Starting. ' + NUTEX_TABS.length + ' tabs will be built; this takes several minutes.');
  }
  nutexClearTriggers_();

  var phases = ['sheets', 'content', 'rules', 'finish', 'protect'];
  while (state.phase !== 'done') {
    var each = { sheets: nutexStepSheet_, content: nutexStepContent_, rules: nutexStepRules_, protect: nutexStepProtect_ }[state.phase];
    if (state.phase === 'protect' && !NUTEX_SETTINGS.SERVICE_ACCOUNT_EMAIL) {
      nutexToast_('Protections skipped: set SERVICE_ACCOUNT_EMAIL, then use NUTEX -> Add protections only.');
      state = { phase: 'done', next: 0 };
      break;
    }
    if (each) {
      while (state.next < NUTEX_TABS.length) {
        if (Date.now() - started > NUTEX_BUDGET_MS) {
          props.setProperty(NUTEX_STATE_KEY, JSON.stringify(state));
          ScriptApp.newTrigger('nutexBuild').timeBased().after(60 * 1000).create();
          nutexToast_('Step "' + state.phase + '" ' + state.next + '/' + NUTEX_TABS.length + ' done. Continuing automatically in a minute.');
          return;
        }
        each(ss, NUTEX_TABS[state.next], state.next);
        state.next++;
        props.setProperty(NUTEX_STATE_KEY, JSON.stringify(state));
      }
    } else {
      nutexStepFinish_(ss);
    }
    state = { phase: phases[phases.indexOf(state.phase) + 1] || 'done', next: 0 };
    props.setProperty(NUTEX_STATE_KEY, JSON.stringify(state));
    SpreadsheetApp.flush();
  }
  props.deleteProperty(NUTEX_STATE_KEY);
  nutexClearTriggers_();
  nutexAlert_('NUTEX', 'Workbook built: ' + NUTEX_TABS.length + ' tabs. Next: NUTEX -> Check workbook, then run `npm run google:init` on your computer.');
}

function nutexClearTriggers_() {
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'nutexBuild') ScriptApp.deleteTrigger(t); });
}

function nutexReset() {
  PropertiesService.getDocumentProperties().deleteProperty(NUTEX_STATE_KEY);
  nutexClearTriggers_();
  nutexAlert_('NUTEX', 'Build progress cleared. If tabs already exist, delete them (or use a new blank sheet) before building again.');
}

function nutexCol_(i) {
  var s = '';
  var n = i + 1;
  while (n > 0) { var r = (n - 1) % 26; s = String.fromCharCode(65 + r) + s; n = Math.floor((n - 1) / 26); }
  return s;
}

/** runs of equal values: [[startIndex, length, value], ...] */
function nutexRuns_(values) {
  var runs = [];
  values.forEach(function (v, i) {
    var last = runs[runs.length - 1];
    if (last && last[2] === v) last[1]++; else runs.push([i, 1, v]);
  });
  return runs;
}

// ---------------------------------------------------------------- step 1: empty tabs with headers
function nutexStepSheet_(ss, t, index) {
  var old = ss.getSheetByName(t.name);
  if (old) ss.deleteSheet(old);
  var sh = ss.insertSheet(t.name, index);
  var rows = t.rows + 1;
  var cols = t.cols.length + 1;
  var mr = sh.getMaxRows();
  if (mr < rows) sh.insertRowsAfter(mr, rows - mr); else if (mr > rows) sh.deleteRows(rows + 1, mr - rows);
  var mc = sh.getMaxColumns();
  if (mc < cols) sh.insertColumnsAfter(mc, cols - mc); else if (mc > cols) sh.deleteColumns(cols + 1, mc - cols);
  sh.setTabColor(NUTEX_COLORS.group[t.group] || NUTEX_COLORS.group.System);
  sh.setFrozenRows(1);
  sh.setFrozenColumns(1);
  var head = sh.getRange(1, 1, 1, t.cols.length);
  head.setValues([t.cols.map(function (c) { return c.n; })]);
  head.setBackgrounds([t.cols.map(function (c) { return c.k ? NUTEX_COLORS.formulaHeader : (t.service ? NUTEX_COLORS.systemHeader : NUTEX_COLORS.inputHeader); })]);
  head.setFontColor(NUTEX_COLORS.headerText).setFontWeight('bold').setVerticalAlignment('middle').setWrapStrategy(SpreadsheetApp.WrapStrategy.CLIP);
  head.setNotes([t.cols.map(function (c) { return c.o || (c.k ? 'Formula column: do not edit' : ''); })]);
  nutexToast_('Tab ' + (index + 1) + '/' + NUTEX_TABS.length + ': ' + t.name);
}

// ---------------------------------------------------------------- step 2: formulas, number formats, widths
function nutexStepContent_(ss, t) {
  var sh = ss.getSheetByName(t.name);
  var n = t.cols.length;
  if (t.fixed) {
    sh.getRange(2, 1, t.fixed.length, n).setValues(t.fixed); // strings that start with = become formulas
  } else {
    var f0 = -1;
    var count = 0;
    t.cols.forEach(function (c, i) { if (c.k) { if (f0 < 0) f0 = i; count++; } });
    if (count) {
      var first = sh.getRange(2, f0 + 1, 1, count);
      first.setFormulas([t.cols.slice(f0, f0 + count).map(function (c) { return c.f; })]);
      if (t.rows > 1) first.copyTo(sh.getRange(3, f0 + 1, t.rows - 1, count), SpreadsheetApp.CopyPasteType.PASTE_FORMULA, false);
    }
  }
  nutexRuns_(t.cols.map(function (c) { return NUTEX_FORMATS[c.t] || ''; })).forEach(function (r) {
    if (r[2]) sh.getRange(2, r[0] + 1, t.rows, r[1]).setNumberFormat(r[2]);
  });
  nutexRuns_(t.cols.map(function (c) {
    return !c.k && c.t === 'text' && (/_code$/.test(c.n) || c.n === 'phone' || c.n === 'bank_ifsc' || /_ref$/.test(c.n)) ? '@' : '';
  })).forEach(function (r) {
    if (r[2]) sh.getRange(2, r[0] + 1, t.rows, r[1]).setNumberFormat(r[2]);
  });
  nutexRuns_(t.cols.map(function (c) { return Math.max(NUTEX_WIDTHS[c.t] || 120, Math.min(220, c.n.length * 8 + 24)); })).forEach(function (r) {
    sh.setColumnWidths(r[0] + 1, r[1], r[2]);
  });
}

// ---------------------------------------------------------------- step 3: dropdowns, checks, named ranges, error highlighting
function nutexStepRules_(ss, t) {
  var sh = ss.getSheetByName(t.name);
  t.cols.forEach(function (c, i) {
    if (c.k) return;
    var range = sh.getRange(2, i + 1, t.rows, 1);
    var L = nutexCol_(i);
    var rule = null;
    if (c.e) {
      rule = SpreadsheetApp.newDataValidation().requireValueInList(NUTEX_ENUMS[c.e], true).setAllowInvalid(false).setHelpText(c.n + ': ' + NUTEX_ENUMS[c.e].join(' / ')).build();
    } else if (c.r) {
      rule = SpreadsheetApp.newDataValidation().requireValueInRange(ss.getRange(c.r), true).setAllowInvalid(true).build();
    } else if (c.t === 'date' || c.t === 'datetime') {
      rule = SpreadsheetApp.newDataValidation().requireDate().setAllowInvalid(true).build();
    } else if (c.t === 'number' || c.t === 'money' || c.t === 'percent') {
      rule = SpreadsheetApp.newDataValidation().requireFormulaSatisfied('=OR(ISBLANK(' + L + '2),ISNUMBER(' + L + '2))').setAllowInvalid(true).build();
    }
    if (rule) range.setDataValidation(rule);
  });
  var key = t.cols.map(function (c) { return c.n; }).indexOf(t.key);
  ss.setNamedRange(t.name + '_KEYS', sh.getRange(2, key + 1, t.rows, 1));
  var f0 = -1;
  var count = 0;
  t.cols.forEach(function (c, i) { if (c.k) { if (f0 < 0) f0 = i; count++; } });
  if (count) {
    var rng = sh.getRange(2, f0 + 1, t.rows, count);
    var cf = SpreadsheetApp.newConditionalFormatRule().whenFormulaSatisfied('=ISERROR(' + nutexCol_(f0) + '2)').setBackground(NUTEX_COLORS.errorFill).setRanges([rng]).build();
    sh.setConditionalFormatRules(sh.getConditionalFormatRules().concat([cf]));
  }
}

// ---------------------------------------------------------------- step 4: LOOKUPS, README, remove the blank default sheet
function nutexStepFinish_(ss) {
  var names = Object.keys(NUTEX_ENUMS);
  var height = 0;
  names.forEach(function (n) { height = Math.max(height, NUTEX_ENUMS[n].length); });
  var grid = [];
  for (var r = 0; r < height; r++) grid.push(names.map(function (n) { return NUTEX_ENUMS[n][r] === undefined ? '' : NUTEX_ENUMS[n][r]; }));
  ss.getSheetByName('LOOKUPS').getRange(2, 1, height, names.length).setValues(grid);
  var readme = NUTEX_TABS.filter(function (t) { return t.name !== 'README'; }).map(function (t) {
    return [t.name, t.group, t.purpose, t.append ? 'YES' : 'no', t.service ? 'Whole tab locked (service account / super admin only)' : 'Formula columns locked; input columns edited via app', t.inputs, t.formulas, t.rows];
  });
  ss.getSheetByName('README').getRange(2, 1, readme.length, 8).setValues(readme);
  ss.getSheets().forEach(function (s) {
    var ours = NUTEX_TABS.some(function (t) { return t.name === s.getName(); });
    if (!ours && s.getLastRow() <= 1 && s.getLastColumn() <= 1 && ss.getSheets().length > 1) ss.deleteSheet(s);
  });
  ss.setActiveSheet(ss.getSheetByName(NUTEX_TABS[0].name));
}

// ---------------------------------------------------------------- step 5: protections
/** `p` is a Protection: sheet.protect() for a whole tab, range.protect() for a block */
function nutexProtect_(p, description) {
  p.setDescription(description);
  p.setWarningOnly(false);
  var me = Session.getEffectiveUser().getEmail();
  var editors = [NUTEX_SETTINGS.SERVICE_ACCOUNT_EMAIL].concat(NUTEX_SETTINGS.ADMIN_EMAILS).filter(function (e) { return e; });
  try { p.removeEditors(p.getEditors().filter(function (u) { return u.getEmail() !== me; })); } catch (e) { /* the owner cannot be removed */ }
  p.addEditors(editors);
  try { p.setDomainEdit(false); } catch (e2) { /* personal accounts have no domain */ }
}

function nutexStepProtect_(ss, t) {
  var sh = ss.getSheetByName(t.name);
  var existing = sh.getProtections(SpreadsheetApp.ProtectionType.RANGE).concat(sh.getProtections(SpreadsheetApp.ProtectionType.SHEET));
  existing.forEach(function (p) { if (/^NUTEX/.test(p.getDescription()) || /^[A-Z_]+: /.test(p.getDescription())) p.remove(); });
  if (t.service) {
    nutexProtect_(sh.protect(), t.name + ': whole tab locked' + (t.append ? ' (append-only)' : ''));
    return;
  }
  nutexProtect_(sh.getRange(1, 1, 1, t.cols.length).protect(), t.name + ': header row');
  var f0 = -1;
  var count = 0;
  t.cols.forEach(function (c, i) { if (c.k) { if (f0 < 0) f0 = i; count++; } });
  if (count) nutexProtect_(sh.getRange(2, f0 + 1, t.rows, count).protect(), t.name + ': formula block (' + t.cols[f0].n + '..' + t.cols[f0 + count - 1].n + ')');
}

function nutexProtectOnly() {
  if (!NUTEX_SETTINGS.SERVICE_ACCOUNT_EMAIL) { nutexAlert_('NUTEX', 'Set SERVICE_ACCOUNT_EMAIL at the top of the script first.'); return; }
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var started = Date.now();
  var i = Number(PropertiesService.getDocumentProperties().getProperty('nutex_protect_next') || 0);
  for (; i < NUTEX_TABS.length; i++) {
    if (Date.now() - started > NUTEX_BUDGET_MS) {
      PropertiesService.getDocumentProperties().setProperty('nutex_protect_next', String(i));
      nutexAlert_('NUTEX', 'Protected ' + i + '/' + NUTEX_TABS.length + ' tabs. Run "Add protections only" again to continue.');
      return;
    }
    nutexStepProtect_(ss, NUTEX_TABS[i]);
  }
  PropertiesService.getDocumentProperties().deleteProperty('nutex_protect_next');
  nutexAlert_('NUTEX', 'All tabs protected.');
}

// ---------------------------------------------------------------- check
function nutexCheck() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var problems = [];
  var names = ss.getSheets().map(function (s) { return s.getName(); });
  var expected = NUTEX_TABS.map(function (t) { return t.name; });
  if (JSON.stringify(names) !== JSON.stringify(expected)) problems.push('Tab order or names differ. Sheet has: ' + names.join(', '));
  NUTEX_TABS.forEach(function (t) {
    var sh = ss.getSheetByName(t.name);
    if (!sh) { problems.push(t.name + ': tab missing'); return; }
    var n = t.cols.length;
    var head = sh.getRange(1, 1, 1, n).getValues()[0];
    var bad = t.cols.filter(function (c, i) { return head[i] !== c.n; }).length;
    if (bad) problems.push(t.name + ': ' + bad + ' header(s) differ');
    if (sh.getMaxRows() !== t.rows + 1) problems.push(t.name + ': ' + (sh.getMaxRows() - 1) + ' rows, expected ' + t.rows + ' (capacity scale ' + NUTEX_SCALE + ')');
    var fcols = t.cols.map(function (c, i) { return c.k ? i : -1; }).filter(function (i) { return i >= 0; });
    if (fcols.length && !t.fixed) {
      var f = sh.getRange(2, fcols[0] + 1, 1, fcols.length).getFormulas()[0];
      var drift = fcols.filter(function (ci, k) { return f[k] !== t.cols[ci].f; }).length;
      if (drift) problems.push(t.name + ': ' + drift + ' formula(s) differ from the schema');
    }
  });
  nutexAlert_(problems.length ? 'NUTEX check: ' + problems.length + ' problem(s)' : 'NUTEX check: OK',
    problems.length ? problems.slice(0, 15).join('\n') : 'All ' + NUTEX_TABS.length + ' tabs, headers and formulas match the schema. Next: npm run google:init on your computer.');
}
